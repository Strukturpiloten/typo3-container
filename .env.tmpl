# Podman namespace used for all containers, volumes and networks.
PODMAN_NAMESPACE={{ .PodmanNamespace }}
PODMAN_SERVICE={{ .PodmanService }}
PODMAN_STAGE={{ .PodmanStage }}

# User and group IDs running the containers.
PODMAN_USER_UID={{ .UserUID }}
PODMAN_GROUP_GID={{ .GroupGID }}

# DatabaseSQL
DATABASE_SQL_SERVICE={{ .DatabaseSQLService }}

{{ if not .UseReverseProxy -}}
# SSL
PODMAN_SSL_DIR_HOST={{ .SSLDir }}

{{ end -}}
# typo3-installer
# Several variables are set in the 'typo3-phpfpm' section.
# PODMAN_TYPO3INSTALLER_TYPO3_CONFIG_SCRIPT_FILE_HOST={{ .DataDir }}/configs/typo3-installer/typo3_config_default.php
# PODMAN_TYPO3INSTALLER_TYPO3_CONFIG_SCRIPT_FILE_CONTAINER=/etc/typo3_config.php
PODMAN_TYPO3INSTALLER_ENTRYPOINT_SCRIPT_FILE_HOST={{ .DataDir }}/configs/typo3-installer/entrypoint_default.sh
PODMAN_TYPO3INSTALLER_ENTRYPOINT_SCRIPT_FILE_CONTAINER=/etc/entrypoint.sh

# typo3-manager
PODMAN_TYPO3MANAGER_CRON_ROOT_FILE_HOST={{ .DataDir }}/configs/typo3-manager/cron/cron
PODMAN_TYPO3MANAGER_CRON_ROOT_FILE_CONTAINER=/etc/crontabs/cron
PODMAN_TYPO3MANAGER_ENTRYPOINT_SCRIPT_FILE_HOST={{ .DataDir }}/configs/typo3-manager/entrypoint_default.sh
PODMAN_TYPO3MANAGER_ENTRYPOINT_SCRIPT_FILE_CONTAINER=/etc/entrypoint.sh

{{ if .UseMariaDB -}}
# mariadb
# https://hub.docker.com/_/mariadb
PODMAN_MARIADB_IMAGE=docker.io/mariadb:11.8.9-ubi9@sha256:deb8c8a2e960b45ec7bedd68e9de88bbb32687d2027327b1e2c4f8f2341e8827
# Uncomment if you want to use a custom mariadb.conf file:
# PODMAN_MARIADB_CONF_FILE_HOST={{ .DataDir }}/configs/mariadb/mariadb.conf
# PODMAN_MARIADB_CONF_FILE_CONTAINER=/etc/mariadb/mariadb.conf
PODMAN_MARIADB_DATA_DIR_HOST={{ .DataDir }}/mariadb
PODMAN_MARIADB_DATA_DIR_CONTAINER=/var/lib/mysql

DATABASE_SQL_HOST=mariadb
DATABASE_SQL_PORT=3306
DATABASE_SQL_NAME=typo3
DATABASE_SQL_USER=typo3
DATABASE_SQL_PASSWORD='{{ .Password.DatabaseSQLPassword }}'
MARIADB_ROOT_PASSWORD='{{ .Password.MariaDBRootPassword }}'
# Will always be used (true) if it's not empty
# Set to = (without value) if you don't want to use it (false)
MARIADB_AUTO_UPGRADE=this_variable_is_used_when_not_empty

{{ end -}}
{{ if .UsePostgreSQL -}}
# postgresql
# https://hub.docker.com/_/postgres
PODMAN_POSTGRES_IMAGE=docker.io/postgres:18.4-alpine3.22@sha256:774521500f4c22761b25a6bdb772a0a3c2e8dd32468210bdad9231c5752ea398
# Uncomment if you want to use a custom postgresql.conf file:
# PODMAN_POSTGRES_CONF_FILE_HOST={{ .DataDir }}/configs/postgres/postgres.conf
# PODMAN_POSTGRES_CONF_FILE_CONTAINER=/etc/postgresql/postgresql.conf
PODMAN_POSTGRES_DATA_DIR_HOST={{ .DataDir }}/postgres
PODMAN_POSTGRES_DATA_DIR_CONTAINER=/var/lib/postgresql/data

DATABASE_SQL_HOST=postgresql
DATABASE_SQL_PORT=5432
DATABASE_SQL_NAME=typo3
DATABASE_SQL_USER=typo3
DATABASE_SQL_PASSWORD='{{ .Password.DatabaseSQLPassword }}'

{{ end -}}
# nginx
# https://hub.docker.com/r/nginxinc/nginx-unprivileged
PODMAN_NGINX_IMAGE=docker.io/nginxinc/nginx-unprivileged:1.29.3-alpine3.22@sha256:5aea7cc516b419e3526f47dd1531be31a56a046cfe44754d94f9383e13e2ee99
PODMAN_NGINX_CONF_DIR_HOST={{ .DataDir }}/configs/nginx/conf
PODMAN_NGINX_CONF_DIR_CONTAINER=/etc/nginx/conf.d
PODMAN_NGINX_SSL_DIR_CONTAINER=/etc/ssl/nginx

{{ if .UseReverseProxy -}}
NGINX_INTERNAL_URL=http://nginx:8080
{{ else -}}
NGINX_INTERNAL_URL=https://nginx:8443
{{- end }}

# typo3-phpfpm
# https://github.com/Strukturpiloten/typo3-phpfpm/pkgs/container/typo3-phpfpm
PODMAN_TYPO3PHPFPM_IMAGE=ghcr.io/strukturpiloten/typo3-phpfpm:latest
PODMAN_TYPO3PHPFPM_PULL_POLICY=missing
PODMAN_TYPO3PHPFPM_CONF_FILE_HOST={{ .DataDir }}/configs/typo3-phpfpm/conf/zzz-www_default.conf
PODMAN_TYPO3PHPFPM_CONF_FILE_CONTAINER=/usr/local/etc/php-fpm.d/zzz-www.conf
PODMAN_TYPO3PHPFPM_INI_FILE_HOST={{ .DataDir }}/configs/typo3-phpfpm/ini/typo3_default.ini
PODMAN_TYPO3PHPFPM_INI_FILE_CONTAINER=/usr/local/etc/php/conf.d/typo3.ini
# PODMAN_TYPO3PHPFPM_HEALTHCHECK_FILE_HOST={{ .DataDir }}/configs/typo3-phpfpm/typo3_status.php
# PODMAN_TYPO3PHPFPM_HEALTHCHECK_FILE_CONTAINER=/etc/typo3_status.php

# typo3
PODMAN_TYPO3_DATA_DIR_HOST={{ .DataDir }}/typo3
PODMAN_TYPO3_DATA_DIR_CONTAINER=/var/www/typo3
PODMAN_TYPO3_USER_DATA_DIR_CONTAINER=/var/www/typo3/public/fileadmin

TYPO3_VERSION=14.3.1
TYPO3_COMPOSER_PACKAGE=typo3/cms-base-distribution
TYPO3_BIN_RELATIVE_PATH="vendor/bin/typo3"
TYPO3_DB_DRIVER={{ if .UseMariaDB }}pdoMysql{{ else }}postgres{{ end }}
TYPO3_DISTRIBUTION=none
TYPO3_PROJECT_NAME={{ .PodmanService }}
TYPO3_SERVER_TYPE=other
TYPO3_SETUP_ADMIN_USERNAME=admin
TYPO3_SETUP_ADMIN_PASSWORD='{{ .Password.TYPO3SetupAdminPassword }}'
TYPO3_SETUP_ADMIN_EMAIL=typo3@example.com
TYPO3_SETUP_CREATE_SITE=https://{{ .DomainName }}/

# Optional typo3-installer commands run after the initial TYPO3 setup and extension:setup.
# Use one multiline shell script value. Leave it empty to skip optional typo3-installer steps.
# Example:
# TYPO3_OPTIONAL_INSTALL_COMMANDS='composer require nitsan/ns-license
# composer exec -- vendor/bin/typo3 extension:setup
# composer config repositories.t3planet "{"type":"composer","url":"https://composer.t3planet.cloud","only":["nitsan/ns-theme-t3karma"]}"
# composer config http-basic.composer.t3planet.cloud "<username>" "<secret>"
# composer req nitsan/ns-theme-t3karma --with-all-dependencies
# composer exec -- vendor/bin/typo3 extension:setup'
TYPO3_OPTIONAL_INSTALL_COMMANDS=''
