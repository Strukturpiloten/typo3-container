ARG PODMAN_TYPO3PHPFPM_IMAGE
FROM ${PODMAN_TYPO3PHPFPM_IMAGE}

ARG OCI_BASE_DIGEST=""
ARG OCI_BASE_NAME=""
ARG OCI_CREATED=""
ARG OCI_DESCRIPTION="TYPO3 PHP-FPM runtime image with TYPO3 extensions and container utilities"
ARG OCI_DOCUMENTATION="https://github.com/Strukturpiloten/typo3-container"
ARG OCI_LICENSES="AGPL-3.0-only"
ARG OCI_REVISION=""
ARG OCI_SOURCE="https://github.com/Strukturpiloten/typo3-container"
ARG OCI_TITLE="TYPO3 PHP-FPM"
ARG OCI_URL="https://github.com/Strukturpiloten/typo3-container"
ARG OCI_VENDOR="Strukturpiloten"
ARG OCI_VERSION=""

LABEL org.opencontainers.image.base.digest="${OCI_BASE_DIGEST}" \
    org.opencontainers.image.base.name="${OCI_BASE_NAME}" \
    org.opencontainers.image.created="${OCI_CREATED}" \
    org.opencontainers.image.description="${OCI_DESCRIPTION}" \
    org.opencontainers.image.documentation="${OCI_DOCUMENTATION}" \
    org.opencontainers.image.licenses="${OCI_LICENSES}" \
    org.opencontainers.image.revision="${OCI_REVISION}" \
    org.opencontainers.image.source="${OCI_SOURCE}" \
    org.opencontainers.image.title="${OCI_TITLE}" \
    org.opencontainers.image.url="${OCI_URL}" \
    org.opencontainers.image.vendor="${OCI_VENDOR}" \
    org.opencontainers.image.version="${OCI_VERSION}"

ADD --chmod=0755 https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions /usr/local/bin/

RUN apk update && \
    apk upgrade && \
    apk add --no-cache \
    ca-certificates \
    git \
    supercronic \
    tzdata

RUN install-php-extensions \
    @composer \
    apcu \
    exif \
    gd \
    gmp \
    imagick \
    intl \
    pcntl \
    pdo_mysql \
    pdo_pgsql \
    pgsql \
    phar \
    redis \
    sodium \
    sysvsem \
    zip

RUN mv "${PHP_INI_DIR}/php.ini-production" "${PHP_INI_DIR}/php.ini"

ARG PODMAN_TYPO3_DATA_DIR_CONTAINER
RUN mkdir -p /opt/container-utilities/shell ${PODMAN_TYPO3_DATA_DIR_CONTAINER}
COPY deps/container-utilities/shell/check_variables_and_directories.sh /opt/container-utilities/shell/check_variables_and_directories.sh

WORKDIR /var/www/typo3

ENV HOME /home/www-data
RUN chmod 777 /home/www-data

STOPSIGNAL SIGKILL
